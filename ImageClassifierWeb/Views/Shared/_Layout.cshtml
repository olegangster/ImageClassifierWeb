<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { --bg:#f4f6fb; --card:#fff; --text:#1c2333; --muted:#667085; --accent:#3b6cf6; --line:#e4e7ee; }
        @@media (prefers-color-scheme: dark) {
            :root { --bg:#12151d; --card:#1b2030; --text:#e8ebf4; --muted:#9aa3b5; --accent:#6c8dff; --line:#2b3248; }
        }
        * { box-sizing: border-box; }
        body { margin:0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background:var(--bg); color:var(--text); }
        main { max-width: 720px; margin: 0 auto; padding: 32px 16px 64px; }
        h1 { font-size: 1.6rem; margin: 0 0 4px; }
        .sub { color: var(--muted); margin-bottom: 24px; }
        .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:20px; margin-bottom:20px; }
        label { display:block; font-weight:600; margin: 0 0 6px; }
        input[type=file], input[type=url] { width:100%; padding:10px; border:1px solid var(--line); border-radius:8px; background:var(--bg); color:var(--text); }
        .field { margin-bottom: 16px; }
        button { background:var(--accent); color:#fff; border:0; border-radius:8px; padding:11px 22px; font-size:1rem; cursor:pointer; }
        button:disabled { opacity:.6; cursor:wait; }
        .err { border-color:#e5484d; color:#e5484d; }
        .bar { height:10px; background:var(--line); border-radius:6px; overflow:hidden; margin:6px 0 14px; }
        .bar > div { height:100%; background:var(--accent); }
        .row { display:flex; justify-content:space-between; gap:12px; }
        img.preview { max-width:100%; max-height:320px; border-radius:10px; display:block; margin-bottom:16px; }
        .muted { color:var(--muted); font-size:.9rem; }
        .big { font-size:1.5rem; font-weight:700; }
    </style>
</head>
<body>
<main>
    @RenderBody()
</main>
</body>
</html>
